netbox_webhook_name: "netbox-proxmox-webhook"
log_level: INFO # DEBUG, INFO, WARNING, ERROR or CRITICAL

proxmox_api_config:
  api_host: proxmox-ip-or-hostname
  api_port: 8006
  api_user: proxmox_api_user
  api_token_id: name_of_proxmox_api_token
  api_token_secret: proxmox_api_secret_token
  verify_ssl: false
  # Log sanitized Proxmox request/response payloads, but only in Flask debug mode.
  debug_payloads: false
  # Used only when a new VM/LXC has no assigned NetBox device.
  # default_node: optional-proxmox-node-name
  task_timeout_seconds: 600
  # Optional; prefer proxmox_public_ssh_key for LXC provisioning.
  # lxc_default_password: use-a-secret-value
netbox_api_config:
  api_proto: http # or https
  api_host: name or ip of NetBox host
  api_port: 8000
  api_token: netbox_api_secret_token
  verify_ssl: false # or true, up to you
  # Log sanitized NetBox API and incoming webhook payloads, but only in Flask debug mode.
  debug_payloads: false

